# ── OpenAI API Configuration ─────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4.1
WHISPER_MODEL=whisper-1

# ── FastAPI Server Configuration ──────────────────────────────
HOST=localhost
PORT=8000

# ── Logging Configuration ─────────────────────────────────────
LOG_LEVEL=INFO

# ── Google Workspace Integration ──────────────────────────────
# ID of the target Google Sheet where tasks are appended
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheet-id-here

# Relative path to your Google Service Account Credentials JSON file
GOOGLE_SHEETS_CREDS_FILE=app/ai-driven-task-scheduler-your-creds.json

# Optional: Google Drive folder ID to upload attachments into (highly recommended to bypass Service Account quotas)
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-shared-folder-id-here

# ── Public URL Override (Optional) ────────────────────────────
# Set this to your public ngrok tunnel or production server domain (e.g. https://xxxx.ngrok-free.dev)
# to make local/temp file attachments globally accessible when opened from Google Sheets.
# APP_URL=https://your-public-url.ngrok-free.dev
